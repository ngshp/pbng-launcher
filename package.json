{
  "name": "pbng-launcher",
  "version": "18.2.0",
  "description": "PBNG Launcher Official",
  "main": "src/main.js",
  "author": "ngshp <ngshp@example.com>",
  "build": {
    "appId": "com.pbng.launcher",
    "productName": "PBNG Launcher",
    "win": {
      "target": "portable",
      "icon": null
    },
    "portable": {
      "artifactName": "PBNG-Launcher-${version}.exe"
    },
    "directories": {
      "buildResources": "build"
    }
  },
  "scripts": {
    "start": "electron src/main.js",
    "build": "electron-builder --win portable --x64 --publish never"
  }
}
