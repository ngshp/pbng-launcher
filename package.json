{
  "name": "pbng-launcher",
  "version": "18.2.0",
  "description": "PBNG Launcher Official",
  "main": "src/main.js",
  "author": "ngshp",
  "license": "MIT",
  "private": false,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable --x64 --publish never"
  },
  "build": {
    "appId": "com.pbng.launcher",
    "productName": "PBNG Launcher",
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "PBNG-Launcher-v${version}.exe"
    },
    "asar": true,
    "files": [
      "src/**/*",
      "index.html",
      "!**/*.ts",
      "!**/*.map"
    ]
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.9.0"
  }
}
