{
  "name": "pbng-launcher",
  "version": "18.2.0",
  "description": "PBNG Launcher Official - Anti-Cheat Protected",
  "main": "src/main.js",
  "author": "ngshp <ngshp@pbng.id>",
  "license": "MIT",
  "private": false,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable --x64 --publish never"
  },
  "build": {
    "appId": "com.pbng.launcher",
    "productName": "PBNG Launcher",
    "copyright": "© 2025 PBNG Team",
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "PBNG-Launcher-v${version}.exe"
    },
    "asar": true
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.7"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.9.0"
  }
}
