{
  "name": "pbng-launcher",
  "version": "18.2.0",
  "main": "main.js",
  "scripts": { "build": "electron-builder --win portable --x64 --publish never" },
  "dependencies": { "electron-log": "^5.1.2", "electron-updater": "^6.3.9", "ps-list": "^8.1.1" },
  "devDependencies": { "electron": "^30.0.9", "electron-builder": "^24.9.1" },
  "build": {
    "appId": "com.pbng.launcher",
    "productName": "PBNG-Launcher",
    "files": ["main.js","preload.js","src/**/*","package.json"],
    "win": { "target": "portable" },
    "portable": { "artifactName": "PBNG-Launcher-Portable-${version}.exe" }
  }
}
